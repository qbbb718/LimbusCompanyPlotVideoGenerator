<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.0</version>
        <relativePath/>
    </parent>

    <groupId>com.lbc_plot</groupId>
    <artifactId>demo</artifactId>
    <version>0.5.1-SNAPSHOT</version>
    <name>LimbusCompany Plot Video Generator</name>
    <description>LimbusCompany Plot Video Generator</description>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <maven.compiler.encoding>UTF-8</maven.compiler.encoding>
        <java.version>21</java.version>
    </properties>

    <dependencies>
        <!-- Spring Boot Starters -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jdbc</artifactId>
        </dependency>

        <!-- JavaCV: 仅打包 Windows x86_64 原生库 (javacv-platform 会引入全部18个平台≈1GB) -->
        <dependency>
            <groupId>org.bytedeco</groupId>
            <artifactId>javacv</artifactId>
            <version>1.5.9</version>
        </dependency>
        <!-- Windows x86_64 原生库 -->
        <dependency>
            <groupId>org.bytedeco</groupId>
            <artifactId>javacpp</artifactId>
            <version>1.5.9</version>
            <classifier>windows-x86_64</classifier>
        </dependency>
        <dependency>
            <groupId>org.bytedeco</groupId>
            <artifactId>ffmpeg</artifactId>
            <version>6.0-1.5.9</version>
            <classifier>windows-x86_64</classifier>
        </dependency>

        <!-- 日志相关 -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
        </dependency>

        <!-- 测试相关 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- SQLite JDBC 驱动 -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.45.2.0</version>
        </dependency>

        <!-- JDBI 核心库 -->
        <dependency>
            <groupId>org.jdbi</groupId>
            <artifactId>jdbi3-core</artifactId>
            <version>3.37.1</version>
        </dependency>

        <!-- JDBI SQLite 插件（需单独添加） -->
        <dependency>
            <groupId>org.jdbi</groupId>
            <artifactId>jdbi3-sqlite</artifactId>
            <version>3.37.1</version>
        </dependency>

        <!-- JDBI SQL对象扩展 -->
        <dependency>
            <groupId>org.jdbi</groupId>
            <artifactId>jdbi3-sqlobject</artifactId>
            <version>3.37.1</version>
        </dependency>
        
        <!-- Spring Data JDBC SQLite方言 -->
        <!-- 注意：spring-boot-starter-data-jdbc依赖已在上面声明，此处删除重复声明 -->
        
        <dependency>
            <groupId>org.hibernate.orm</groupId>
            <artifactId>hibernate-community-dialects</artifactId>
            <version>6.4.0.Final</version>
        </dependency>

        <!-- JSON -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- Actuator + Micrometer Prometheus -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <!-- Redis support (prototype queue) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- 图像处理优化 -->
        <dependency>
            <groupId>net.coobird</groupId>
            <artifactId>thumbnailator</artifactId>
            <version>0.4.20</version>
        </dependency>

        <dependency>
            <groupId>org.json</groupId>
            <artifactId>json</artifactId>
            <version>20231013</version>
        </dependency>

        <!-- 拼音转换：中文角色名转拼音目录名 -->
        <dependency>
            <groupId>com.belerweb</groupId>
            <artifactId>pinyin4j</artifactId>
            <version>2.5.1</version>
        </dependency>

    </dependencies>

    <repositories>
        <repository>
            <id>aliyun</id>
            <url>https://maven.aliyun.com/repository/public</url>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>true</enabled>
            </snapshots>
        </repository>
    </repositories>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.lbc_plot.MainApplication</mainClass>
                    <jvmArguments>
                        -Dfile.encoding=UTF-8
                        -Dconsole.encoding=UTF-8
                        -Duser.timezone=Asia/Shanghai
                    </jvmArguments>
                    <!--
                        JavaCV/JavaCPP 的原生库必须能从「包装进安装包之后的形态」加载出来。

                        repackage 会把所有依赖塞进 BOOT-INF/lib/*.jar（嵌套 jar），原生 jar
                        也不例外。JavaCPP 的 Loader 会先把 DLL 释放到自己的缓存目录
                        （org.bytedeco.javacpp.cachedir，由 NativeLibraryBootstrap 固定到
                        %LOCALAPPDATA%\limbus-plot-video-generator-javacpp）再 System.load；
                        这条链路一旦断掉，它不会报「找不到 DLL」，而是退化成
                        System.loadLibrary("jniavutil")，最终以
                        UnsatisfiedLinkError: no jniavutil in java.library.path 收场，
                        并被 avutil 的静态初始化失败缓存成
                        NoClassDefFoundError: Could not initialize class
                        org.bytedeco.ffmpeg.global.avutil —— 症状就是立绘（WebP，Java 21 的
                        ImageIO 不支持，只能靠 FFmpeg 兜底）渲染成红色“加载失败”占位图。

                        注意：这里<b>刻意不使用</b> requiresUnpack。spring-boot-maven-plugin 3.2.0
                        对「带 classifier 的原生包」不会生成解包标记（实测打出来的 jar 里没有
                        任何解包注释），配了也是空转；而且 Spring Boot 把嵌套 jar 解到临时目录
                        这件事本身也不解决 JavaCPP 的问题 —— 它能直接读 jar-in-jar，官方推荐做法
                        就是把缓存目录固定下来。要回归验证请用真实的安装包形态，命令是
                        java -jar <jar 文件> 加上 self-check 参数（XML 注释里不能写连续两个
                        连字符，所以这里无法照抄完整命令行；完整写法见 docs\本地打包说明.md）：

                            self-check=webp

                        扁平 classpath（mvn spring-boot:run / mvn test）下原生 jar 是磁盘上的
                        真实文件，本地永远看不出这个问题，所以这个自检必须在打好的 jar 上跑。
                    -->
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <release>21</release>
                </configuration>
            </plugin>

            <!--
                测试的运行时数据根目录固定为模块目录（demo/），这样
                RuntimePaths 解析出的素材目录就是仓库内已存在的 demo/assets，
                测试不再依赖 JVM 工作目录，也不会去动已安装版本的用户数据目录
                （%APPDATA%\limbus-company-plot-video-generator）。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <lbc.data.dir>${project.basedir}</lbc.data.dir>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
            </resource>
        </resources>
    </build>

</project>